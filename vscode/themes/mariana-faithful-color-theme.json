  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A6ACB9"
      }
    },
    {
      "name": "String",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#99C794"
      }
    },
    {
      "name": "String Key",
      "scope": [
        "meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#5FB4B4"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#5FB4B4"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F9AE58"
      }
    },
    {
      "name": "Number Suffix",
      "scope": [
        "storage.type.numeric"
      ],
      "settings": {
        "foreground": "#C695C6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Built-in constant",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#EC5F66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "User-defined constant",
